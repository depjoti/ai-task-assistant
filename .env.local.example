OPENAI_API_KEY=

# Optional: point the OpenAI SDK at any OpenAI-compatible endpoint instead of
# api.openai.com — e.g. Groq's free tier (console.groq.com):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-20b

# Required for the document Q&A feature (embeddings). Free via Google AI
# Studio: aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for the document Q&A feature (persistent chunk/vector storage,
# so uploads survive across serverless requests). Free via upstash.com —
# create a Redis database and copy the REST URL/token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
